#include <iostream>
using namespace std;
int main() {
double montoCompra, descuento = 0.0, montoFinal;
cout << "Ingrese el monto total de la compra (Bs): ";
cin >> montoCompra;
if (montoCompra > 100.0) {
descuento = montoCompra * 0.10;
}
montoFinal = montoCompra - descuento;
cout << "El total final a pagar es: " << montoFinal << " Bs" << endl;
return 0;
}
