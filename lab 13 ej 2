#include <iostream>
#include <string>
using namespace std;

// Prototipos
void registrar(string &mensaje);
int contarCaracteres(string mensaje);
void mostrarCantidad(int cantidad);

int main() {
    string mensaje;
    int cantidad;

    registrar(mensaje);

    cantidad = contarCaracteres(mensaje);

    cout << "Mensaje: " << mensaje << endl;
    mostrarCantidad(cantidad);

    return 0;
}

// Registrar mensaje
void registrar(string &mensaje) {
    cout << "Ingrese un mensaje: ";
    getline(cin, mensaje);
}

// Contar caracteres
int contarCaracteres(string mensaje) {
    return mensaje.length();
}

// Mostrar cantidad
void mostrarCantidad(int cantidad) {
    cout << "Cantidad de caracteres: " << cantidad << endl;
}
