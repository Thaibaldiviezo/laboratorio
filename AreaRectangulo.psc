Proceso AreaRectangulo 
	
	Definir base Como Real
	Definir altura Como Real
	
	Escribir " Ingrese la base del area del rectangulo " 
	Leer base
	Escribir " Ingrese la altura del area del rectangulo "
	Leer altura
	
	Area=base*altura
	Escribir "area del rectangulo : ",area 
FinAlgoritmo 
